{
  "format": 1,
  "id": "com.blockworked.voxel",
  "name": "Voxel",
  "version": "0.2.0",
  "description": "Cube and smooth terrain with sculpting, player saves, bounded streaming, optional GPU meshing and editable fracture bodies. A portable sandboxed module.",
  "license": "MIT",
  "engine": ">=0.0.1",
  "tier": "portable",
  "abi": 1,
  "sdk": "^0.0",
  "runtime": {
    "portable": {
      "module": "portable/voxel.wasm",
      "memory_limit_mib": 256,
      "call_limit_ms": 10000
    }
  },
  "editor": {
    "preview": true
  },
  "contributions": [
    "schemas/voxel.json"
  ],
  "capabilities": [
    "project-storage",
    "gpu-compute"
  ]
}
