  "tools": [
    {
      "name": "paint",
      "title": "Voxel paint",
      "description": "Click a surface to save a cube of the chosen material against it.",
      "cast": "cast",
      "outline": "before_box",
      "drag": true,
      "reach": 200,
      "command": "paint_voxel",
      "args": {
        "x": "$hit.before.0",
        "y": "$hit.before.1",
        "z": "$hit.before.2",
        "material": "$option.material"
      },
      "options": [
        {"name": "material", "type": "choice", "options": ["air", "stone", "dirt", "grass", "sand", "wood", "leaves", "glow"], "default": "stone"}
      ]
    },
    {
      "name": "erase",
      "title": "Voxel erase",
