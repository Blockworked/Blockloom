{
  "resources": [
    {
      "type_id": "world",
      "display_name": "Voxel world",
      "fields": [
        {"name": "preset", "type": "choice", "options": ["island", "caves", "flat", "empty"], "default": "island", "description": "The terrain the world starts as."},
        {"name": "surface", "type": "choice", "options": ["cubes", "smooth"], "default": "cubes", "description": "Cubes keep square edges; smooth interpolates a density field. Sphere brushes sculpt smooth worlds; shaped cells stay crisp."},
        {"name": "seed", "type": "int", "min": -2147483648, "max": 2147483647, "default": 1337, "description": "The same seed and size always make the same world."},
        {"name": "size", "type": "vec3", "default": [64, 32, 64], "description": "Exact cell bounds along x, y and z. Stored in sparse 32-cell sections. At most 4 million cells."},
        {"name": "voxel_size", "type": "number", "min": 0.05, "max": 64, "default": 1, "description": "How big one cell is in world units."},
        {"name": "origin", "type": "vec3", "default": [0, 0, 0], "description": "Where the world's low corner stands."},
        {"name": "solid", "type": "bool", "default": true, "description": "Whether the cells collide."},
        {"name": "palette_colors", "type": "list", "item": {"type": "color"}, "max_len": 255, "default": [], "description": "Colors laid over the built-in materials by position (stone, dirt, grass, sand, wood, leaves, glow); more add materials. Blank keeps the built-in."},
        {"name": "palette_emission", "type": "list", "item": {"type": "number", "min": 0, "max": 100}, "max_len": 255, "default": [], "description": "How strongly each material glows, in the same order. 0 does not glow."},
        {"name": "edits", "type": "list", "item": {"type": "text", "max_len": 120}, "max_len": 4096, "default": [], "description": "Edits laid over the terrain in order: `set X Y Z material`, `fill X1 Y1 Z1 X2 Y2 Z2 material`, `sphere X Y Z radius material`."},
        {"name": "persistent", "type": "bool", "default": false, "description": "Autosave runtime terrain and restore it on the next run. Preview never uses player saves."},
        {"name": "save_slot", "type": "text", "default": "world", "max_len": 64},
        {"name": "streamed", "type": "bool", "default": false},
        {"name": "stream_radius", "type": "int", "min": 0, "max": 8, "default": 2},
        {"name": "vertical_radius", "type": "int", "min": 0, "max": 8, "default": 2},
        {"name": "max_resident_bytes", "type": "int", "min": 32768, "max": 16777216, "default": 16777216},
        {"name": "max_pages", "type": "int", "min": 1, "max": 512, "default": 64},
        {"name": "pages_per_tick", "type": "int", "min": 1, "max": 16, "default": 2},
        {"name": "stream_center", "type": "vec3", "default": [0, 0, 0], "description": "Initial stream centre in cell units; invokers follow actor positions."},
        {"name": "gpu_meshing", "type": "bool", "default": false, "description": "Compute geometry into GPU buffers with CPU collision and fallback."},
        {"name": "max_fragments", "type": "int", "min": 0, "max": 128, "default": 16},
        {"name": "max_fragment_cells", "type": "int", "min": 1, "max": 4096, "default": 4096},
        {"name": "anchor_y", "type": "int", "default": 0, "description": "Cells at or below this height support static structures."},
        {"name": "palette_density", "type": "list", "item": {"type": "number", "min": 0.001, "max": 100000}, "max_len": 255, "default": [], "description": "Material density in kilograms per cubic metre, default 1000."}
      ]
    }
  ],
