{
  "about": "Canvas edits replayed through Backend::dispatch. editor_baseline.rs records each step's reply and the actor's graph, with generated ids numbered by first appearance.",
  "steps": [
    { "command": "create_project", "args": { "name": "Baseline", "location": "$PROJECTS" } },
    { "command": "add_actor", "args": { "shape": "Circle", "name": "Ball" }, "save": "actor" },
    { "command": "select_actor", "args": { "actorId": "$actor" } },
    { "command": "create_variable", "args": { "name": "score" } },
    { "command": "create_list", "args": { "name": "items" } },
    { "command": "set_list_items", "args": { "name": "items", "items": [{ "kind": "Number", "value": 1 }, { "kind": "Text", "value": "two" }] } },
    { "command": "create_dict", "args": { "name": "stats" } },
    { "command": "set_dict_entries", "args": { "name": "stats", "entries": [{ "key": "hp", "value": { "kind": "Number", "value": 3 } }] } },
    { "command": "add_strand", "args": { "x": 0, "y": 0, "instruction": { "type": "WhenStarted" } }, "save": "main" },
    { "command": "add_instruction", "args": { "strandId": "$main", "path": [{ "index": 1, "slot": null }],
        "instruction": { "type": "Repeat", "count": { "kind": "Number", "value": 3 }, "body": [] } } },
    { "command": "add_instruction", "args": { "strandId": "$main", "path": [{ "index": 1, "slot": 0 }, { "index": 0, "slot": null }],
        "instruction": { "type": "Move", "steps": { "kind": "Number", "value": 10 } } } },
    { "command": "add_instruction", "args": { "strandId": "$main", "path": [{ "index": 2, "slot": null }],
        "instruction": { "type": "IfElse",
          "condition": { "kind": "Op", "op": "Gt", "args": [{ "kind": "Var", "name": "score" }, { "kind": "Number", "value": 5 }], "saved": { "kind": "Bool" } },
          "then_body": [{ "type": "Say", "text": { "kind": "Text", "value": "high" } }],
          "else_body": [{ "type": "SetVariable", "name": "score", "value": { "kind": "Number", "value": 0 } }] } } },
    { "note": "numeric spelling in a plain numeric slot",
      "command": "edit_value_field", "args": { "location": { "kind": "Field", "strand_id": "$main", "index": [{ "index": 1, "slot": 0 }, { "index": 0, "slot": null }], "field_id": "MoveSteps", "path": [] }, "text": "09" } },
    { "command": "edit_value_field", "args": { "location": { "kind": "Field", "strand_id": "$main", "index": [{ "index": 1, "slot": 0 }, { "index": 0, "slot": null }], "field_id": "MoveSteps", "path": [] }, "text": "1.50" } },
    { "note": "a partial exponent is kept as a buffer",
      "command": "edit_value_field", "args": { "location": { "kind": "Field", "strand_id": "$main", "index": [{ "index": 1, "slot": 0 }, { "index": 0, "slot": null }], "field_id": "MoveSteps", "path": [] }, "text": "1e" } },
    { "note": "numeric spelling inside an operator argument",
      "command": "edit_value_field", "args": { "location": { "kind": "Field", "strand_id": "$main", "index": [{ "index": 2, "slot": null }], "field_id": "Condition", "path": [1] }, "text": "09" } },
    { "command": "edit_value_field", "args": { "location": { "kind": "Field", "strand_id": "$main", "index": [{ "index": 1, "slot": null }], "field_id": "RepeatCount", "path": [] }, "text": "abc" } },
    { "command": "create_floating_value", "args": { "x": 300, "y": 40, "value": { "kind": "Op", "op": "Join", "args": [{ "kind": "Text", "value": "a" }, { "kind": "Var", "name": "score" }], "saved": { "kind": "Number", "value": 0 } } }, "save": "floating" },
    { "note": "the old canvas's value drag: take the floating block, then put it in a slot (shadowing what was there)",
      "command": "take_value", "args": { "location": { "kind": "Floating", "floating_id": "$floating", "path": [] } }, "save": "taken" },
    { "command": "put_value", "args": { "location": { "kind": "Field", "strand_id": "$main", "index": [{ "index": 2, "slot": 0 }, { "index": 0, "slot": null }], "field_id": "SayText", "path": [] }, "value": "$taken" } },
    { "note": "dragging it back out restores the shadowed text",
      "command": "take_value", "args": { "location": { "kind": "Field", "strand_id": "$main", "index": [{ "index": 2, "slot": 0 }, { "index": 0, "slot": null }], "field_id": "SayText", "path": [] } }, "save": "taken2" },
    { "command": "create_floating_value", "args": { "x": 300, "y": 120, "value": "$taken2", "originBlockId": null } },
    { "note": "a sub-value pulled out of an operator leaves that argument's blank",
      "command": "take_value", "args": { "location": { "kind": "Field", "strand_id": "$main", "index": [{ "index": 2, "slot": null }], "field_id": "Condition", "path": [0] } } },
    { "command": "create_block", "args": { "pieces": [{ "kind": "Label", "id": "l1", "text": "double" }, { "kind": "Input", "id": "in1", "name": "n", "value_type": "Any" }], "shape": "ReturnsValue", "color": "#4C97FF" }, "save": "block" },
    { "command": "add_instruction", "args": { "strandId": "$graph:/strands/1/id", "path": [{ "index": 1, "slot": null }],
        "instruction": { "type": "Return", "value": { "kind": "Op", "op": "Mul", "args": [{ "kind": "Param", "name": "n" }, { "kind": "Number", "value": 2 }], "saved": { "kind": "Number", "value": 0 } } } } },
    { "command": "add_instruction", "args": { "strandId": "$main", "path": [{ "index": 3, "slot": null }],
        "instruction": { "type": "SetVariable", "name": "score", "value": { "kind": "Call", "block_id": "$block", "args": [{ "kind": "Number", "value": 4 }], "saved": { "kind": "Number", "value": 0 } } } } },
    { "command": "add_instruction", "args": { "strandId": "$main", "path": [{ "index": 4, "slot": null }],
        "instruction": { "type": "CallBlock", "block_id": "$block", "args": [{ "kind": "Number", "value": 7 }] } } },
    { "note": "renaming an input keeps call-site values; a new input gets its typed blank",
      "command": "edit_block", "args": { "blockId": "$block", "pieces": [{ "kind": "Label", "id": "l1", "text": "double" }, { "kind": "Input", "id": "in1", "name": "value", "value_type": "Any" }, { "kind": "Input", "id": "in2", "name": "flag", "value_type": "Bool" }], "shape": "ReturnsValue", "color": "#4C97FF" } },
    { "command": "create_comment", "args": { "x": 500, "y": 0, "text": "loose note" } },
    { "command": "create_comment", "args": { "x": 0, "y": 0, "text": "attached note", "attachedTo": "$graph:/strands/0/instructions/1/id" } },
    { "command": "rename_variable", "args": { "oldName": "score", "newName": "points" } },
    { "command": "undo", "args": {} },
    { "command": "redo", "args": {} },
    { "note": "pasting gives the copy fresh ids",
      "command": "paste_instructions", "args": { "x": 600, "y": 300, "instructions": ["$graph:/strands/0/instructions/1"] } },
    { "command": "split_strand", "args": { "strandId": "$main", "path": [{ "index": 3, "slot": null }], "x": 0, "y": 400 } },
    { "command": "remove_instruction", "args": { "strandId": "$main", "path": [{ "index": 1, "slot": 0 }, { "index": 0, "slot": null }] } },
    { "note": "a rejected edit: a header below the first block",
      "command": "add_instruction", "args": { "strandId": "$main", "path": [{ "index": 1, "slot": null }], "instruction": { "type": "WhenStarted" } } },
    { "command": "undo", "args": {} },
    { "command": "undo", "args": {} },
    { "command": "create_floating_value", "args": { "x": 200, "y": 200, "value": { "kind": "Op", "op": "Add", "args": [{ "kind": "Number", "value": 4 }, { "kind": "Number", "value": 2 }], "saved": { "kind": "Number", "value": 0 } }, "originBlockId": null }, "save": "f3" },
    { "note": "a value drag is one move_value: it shadows what the slot held",
      "command": "move_value", "args": { "from": { "kind": "Floating", "floating_id": "$f3", "path": [] }, "to": { "kind": "Field", "strand_id": "$main", "index": [{ "index": 1, "slot": null }], "field_id": "RepeatCount", "path": [] } } },
    { "note": "one gesture, one undo step", "command": "undo", "args": {} },
    { "command": "redo", "args": {} },
    { "note": "a move into its own argument is refused and costs no undo step",
      "command": "move_value", "args": { "from": { "kind": "Field", "strand_id": "$main", "index": [{ "index": 1, "slot": null }], "field_id": "RepeatCount", "path": [] }, "to": { "kind": "Field", "strand_id": "$main", "index": [{ "index": 1, "slot": null }], "field_id": "RepeatCount", "path": [0] } } },
    { "note": "dragging an argument out onto the canvas leaves its blank",
      "command": "move_value", "args": { "from": { "kind": "Field", "strand_id": "$main", "index": [{ "index": 1, "slot": null }], "field_id": "RepeatCount", "path": [1] }, "to": null, "x": 40, "y": 500, "originBlockId": null } },
    { "note": "a not-yet-number is buffered without an undo step",
      "command": "edit_value_field", "args": { "location": { "kind": "Field", "strand_id": "$main", "index": [{ "index": 1, "slot": null }], "field_id": "RepeatCount", "path": [0] }, "text": "-" } },
    { "note": "a tail dropped on the trash is one remove",
      "command": "remove_instruction", "args": { "strandId": "$main", "path": [{ "index": 1, "slot": null }], "count": 5 } },
    { "command": "undo", "args": {} },
    { "note": "copying a stack carries the note pinned to it",
      "command": "copy_instructions", "args": { "strandId": "$main", "path": [{ "index": 1, "slot": null }], "count": null }, "save": "fragment" },
    { "note": "a pasted fragment gets fresh ids and its note follows the clone",
      "command": "paste_fragment", "args": { "x": 600, "y": 600, "fragment": "$fragment" } },
    { "note": "duplicating copies the block, its body and its note right after it",
      "command": "duplicate_instruction", "args": { "strandId": "$main", "path": [{ "index": 1, "slot": null }] } },
    { "command": "undo", "args": {} }
  ]
}
