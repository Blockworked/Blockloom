+
+/// Mali keeps descriptors for unchanged preprocessing buffers across frames.
+#[derive(Default)]
+pub struct PreprocessBindGroupReuseCache {
+    enabled: bool,
+    frame: u64,
+    groups: HashMap<PreprocessBindGroupKey, (BindGroup, u64)>,
+}
+
+impl PreprocessBindGroupReuseCache {
+    fn get_or_create(
+        &mut self,
+        key: PreprocessBindGroupKey,
+        create: impl FnOnce() -> BindGroup,
+    ) -> BindGroup {
+        if !self.enabled {
+            return create();
+        }
+        if let Some((group, frame)) = self.groups.get_mut(&key) {
+            *frame = self.frame;
+            return group.clone();
+        }
+        let group = create();
+        self.groups.insert(key, (group.clone(), self.frame));
+        group
+    }
+}
