+
+/// ARM's PCI vendor ID, matching the Mali denylist in
+/// `blockloom-runtime/src/shadows.rs`.
+const MALI_VENDOR: u32 = 0x13B5;
+
+/// Hash GPU handles, not wrapper addresses that can hold different resources.
+fn hash_binding_resource(state: &mut DefaultHasher, resource: &BindingResource) {
+    match resource {
+        BindingResource::Buffer(binding) => {
+            0u8.hash(state);
+            binding.buffer.hash(state);
+            binding.offset.hash(state);
+            binding.size.hash(state);
+        }
+        BindingResource::BufferArray(bindings) => {
+            1u8.hash(state);
+            bindings.len().hash(state);
+            for binding in *bindings {
+                binding.buffer.hash(state);
+                binding.offset.hash(state);
+                binding.size.hash(state);
+            }
+        }
+        BindingResource::Sampler(sampler) => {
+            2u8.hash(state);
+            sampler.hash(state);
+        }
+        BindingResource::SamplerArray(samplers) => {
+            3u8.hash(state);
+            samplers.len().hash(state);
+            for sampler in *samplers {
+                sampler.hash(state);
+            }
+        }
+        BindingResource::TextureView(view) => {
+            4u8.hash(state);
+            view.hash(state);
+        }
+        BindingResource::TextureViewArray(views) => {
+            5u8.hash(state);
+            views.len().hash(state);
+            for view in *views {
+                view.hash(state);
+            }
+        }
+        BindingResource::AccelerationStructure(tlas) => {
+            6u8.hash(state);
+            tlas.hash(state);
+        }
+        BindingResource::AccelerationStructureArray(tlasses) => {
+            7u8.hash(state);
+            tlasses.len().hash(state);
+            for tlas in *tlasses {
+                tlas.hash(state);
+            }
+        }
+        BindingResource::ExternalTexture(texture) => {
+            8u8.hash(state);
+            texture.hash(state);
+        }
+        // `BindingResource` is non-exhaustive for semver flexibility; the
+        // variants above cover everything wgpu 30 can construct.
+        _ => {
+            9u8.hash(state);
+        }
+    }
+}
+
+/// The full signature a view's three bind groups depend on.
+fn view_bind_group_signature(
+    layout_key: MeshPipelineViewLayoutKey,
+    offsets: &[u32],
+    entries: &[BindGroupEntry],
+    entries_binding_array: &[BindGroupEntry],
+) -> u64 {
+    // Fixed seed: signatures only need to be stable within a run.
+    let mut state = FixedState::with_seed(0x9E3779B97F4A7C15).build_hasher();
+    layout_key.bits().hash(&mut state);
+    offsets.hash(&mut state);
+    entries.len().hash(&mut state);
+    for entry in entries {
+        entry.binding.hash(&mut state);
+        hash_binding_resource(&mut state, &entry.resource);
+    }
+    entries_binding_array.len().hash(&mut state);
+    for entry in entries_binding_array {
+        entry.binding.hash(&mut state);
+        hash_binding_resource(&mut state, &entry.resource);
+    }
+    state.finish()
+}
