{
  "productName": "Blockloom",
  "identifier": "com.blockworked.Blockloom",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "enableGTKAppId": true,
    "windows": [
      {
        "create": false,
        "title": "Blockloom",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png"
    ]
  }
}
